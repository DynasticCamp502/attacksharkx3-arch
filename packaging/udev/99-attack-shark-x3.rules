# Udev rules for Attack Shark X3 Gaming Mouse
# Vendor ID: 0x1d57, Product IDs: 0xfa60 (2.4GHz Wireless Receiver), 0xfa61 (Wired USB)

# 2.4GHz Wireless Receiver
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa60", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa60", MODE="0666", TAG+="uaccess"

# Wired USB Cable Connection
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa61", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa61", MODE="0666", TAG+="uaccess"
